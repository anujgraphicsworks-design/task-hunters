# ==========================================
# TASK HUNTERS - ENVIRONMENT VARIABLES EXAMPLE
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control!
# ==========================================

# SERVER ENVIRONMENT CONFIGURATION
PORT=5000
NODE_ENV=production

# DATABASE CONFIGURATION
# SQLite format: file:./dev.db | PostgreSQL format: postgresql://user:password@host:5432/dbname
DATABASE_URL="file:./dev.db"

# CRYPTOGRAPHIC JWT SIGNING SECRET (Generate with: openssl rand -hex 32)
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars

# PRIMARY ADMIN CREDENTIALS (Server-only)
ADMIN_INITIAL_EMAIL=anuj140906@gmail.com
ADMIN_INITIAL_PASSWORD=YourStrongAdminPasswordHere!2026

# RATE LIMITING CONFIGURATION (THRESHOLDS & EXPONENTIAL BACKOFF)
AUTH_RATE_LIMIT_MAX_PER_IP=10
AUTH_ACCOUNT_MAX_ATTEMPTS=5
PUBLIC_RATE_LIMIT_MAX=60
AUTHED_RATE_LIMIT_MAX=200
EXPONENTIAL_BACKOFF_BASE_SEC=15

# CLIENT FRONTEND PUBLIC CONFIGURATION (Exposed to Vite Browser)
VITE_API_BASE_URL=https://task-hunters-production.up.railway.app/api
VITE_SHEETS_SPREADSHEET_ID=your_google_spreadsheet_id_here
VITE_SHEETS_NAME=Submissions_Log
VITE_SHEETS_API_KEY=your_google_sheets_api_key_here
